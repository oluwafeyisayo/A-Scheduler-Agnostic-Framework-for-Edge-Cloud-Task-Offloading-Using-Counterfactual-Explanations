                throw new IllegalStateException(
                        "A search containing an accepted best "
                        + "candidate cannot have NOT_FOUND status.");
            }

            /*
             * Semantic consistency rule:
             *
             * Every FEASIBLE_EFFECTIVE candidate is accepted, and every
