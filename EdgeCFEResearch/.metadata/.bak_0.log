                throw new IllegalStateException(
                        "Evaluated cardinality total must equal "
                        + "evaluated-candidate count. CardinalityTotal="
                        + evaluatedCardinalityTotal
                        + ", evaluated="
                        + evaluatedCandidateCount
                        + ".");
