                    throw new IllegalStateException(
                            "The best candidate must be accepted.");
                }

                if(bestCandidate.getClassification()
                        != CounterfactualClassification
                        .FEASIBLE_EFFECTIVE) {

                    throw new IllegalStateException(
                            "The best candidate must be classified "
                            + "as FEASIBLE_EFFECTIVE.");
