<?xml version="1.0"?>
<applications>

    <!-- Interactive and highly latency-sensitive workload -->
    <application name="AUGMENTED_REALITY">
        <usage_percentage>25</usage_percentage>
        <prob_cloud_selection>10</prob_cloud_selection>
        <poisson_interarrival>5</poisson_interarrival>
        <delay_sensitivity>0.9</delay_sensitivity>
        <active_period>45</active_period>
        <idle_period>15</idle_period>
        <data_upload>1500</data_upload>
        <data_download>500</data_download>
        <task_length>2500</task_length>
        <required_core>1</required_core>
        <vm_utilization_on_edge>30</vm_utilization_on_edge>
        <vm_utilization_on_cloud>3</vm_utilization_on_cloud>
        <vm_utilization_on_mobile>0</vm_utilization_on_mobile>
    </application>

    <!-- Frequent but relatively lightweight health-monitoring workload -->
    <application name="HEALTH_APP">
        <usage_percentage>25</usage_percentage>
        <prob_cloud_selection>15</prob_cloud_selection>
        <poisson_interarrival>20</poisson_interarrival>
        <delay_sensitivity>0.7</delay_sensitivity>
        <active_period>30</active_period>
        <idle_period>10</idle_period>
        <data_upload>500</data_upload>
        <data_download>100</data_download>
        <task_length>700</task_length>
        <required_core>1</required_core>
        <vm_utilization_on_edge>10</vm_utilization_on_edge>
        <vm_utilization_on_cloud>1</vm_utilization_on_cloud>
        <vm_utilization_on_mobile>0</vm_utilization_on_mobile>
    </application>

    <!-- Compute-intensive video analytics or object-detection workload -->
    <application name="HEAVY_COMP_APP">
        <usage_percentage>25</usage_percentage>
        <prob_cloud_selection>45</prob_cloud_selection>
        <poisson_interarrival>15</poisson_interarrival>
        <delay_sensitivity>0.5</delay_sensitivity>
        <active_period>60</active_period>
        <idle_period>30</idle_period>
        <data_upload>5000</data_upload>
        <data_download>250</data_download>
        <task_length>7000</task_length>
        <required_core>2</required_core>
        <vm_utilization_on_edge>60</vm_utilization_on_edge>
        <vm_utilization_on_cloud>6</vm_utilization_on_cloud>
        <vm_utilization_on_mobile>0</vm_utilization_on_mobile>
    </application>

    <!-- Download-intensive infotainment and content-delivery workload -->
    <application name="INFOTAINMENT_APP">
        <usage_percentage>25</usage_percentage>
        <prob_cloud_selection>30</prob_cloud_selection>
        <poisson_interarrival>10</poisson_interarrival>
        <delay_sensitivity>0.3</delay_sensitivity>
        <active_period>30</active_period>
        <idle_period>30</idle_period>
        <data_upload>100</data_upload>
        <data_download>5000</data_download>
        <task_length>1000</task_length>
        <required_core>1</required_core>
        <vm_utilization_on_edge>15</vm_utilization_on_edge>
        <vm_utilization_on_cloud>1.5</vm_utilization_on_cloud>
        <vm_utilization_on_mobile>0</vm_utilization_on_mobile>
    </application>

</applications>